// Base signing config, committed. Included by every target through
// project.yml (`configFiles`), so both the app and the tests sign the same way.
//
// The team id is personal data and this repo is public, so it lives in
// Local.xcconfig — git-ignored, one include away. Copy
// Config/Local.xcconfig.example to Config/Local.xcconfig and put your Apple
// ID team id there; without it the build still works for the simulator, it
// just has no team to sign with for a device.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
