# Raw media and derived data never go in git (repo is public)
videos/
data/*
!data/.gitkeep
!data/splits.json
*.mp4
*.mov
*.jpeg
*.jpg
*.npz
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# iOS app: the project and its Info.plist are generated from ios/project.yml
ios/*.xcodeproj/
ios/HandstandApp/Info.plist

# Personal signing config (a team id is personal data; repo is public)
ios/Config/Local.xcconfig

# CocoaPods (chainlink #45): Pods/ and the generated workspace are build
# artifacts re-created by `pod install`. Podfile.lock IS committed — it pins
# the MediaPipe version the app was built with.
ios/Pods/
ios/*.xcworkspace

# The user's scoring reference (chainlink #28): built from their own data,
# so it lives outside git — the app finds it as an optional resource folder.
ios/LocalResources/

# ML artifacts (published via releases if needed)
*.mlmodel
*.mlpackage/
*.task
pipeline/models/

# OS / editor
.DS_Store
.vscode/
.idea/

# Local issue tracker (not synced; Mac reaches it over SSH)
.chainlink/

# Worker task prompt copied into each worktree
.worker-prompt.md

# uv temp lock files
uv-*.lock
